# ==============================================================================
# Enterprise Agentic RAG - Environment Configuration
# ==============================================================================

# LLM Provider Configuration (Optional: system runs in high-fidelity offline mode if not set)
LLM_PROVIDER=offline              # Options: 'openai', 'groq', 'ollama', 'offline'
OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Model Selection
LLM_MODEL=llama-3.3-70b-versatile # e.g., 'gpt-4o', 'llama-3.3-70b-versatile', 'llama3'
EMBEDDING_MODEL=bge-m3            # Options: 'bge-m3', 'text-embedding-3-small', 'minilm'

# Retrieval & Reranker Hyperparameters
DENSE_TOP_K=15
SPARSE_BM25_TOP_K=15
RERANKER_TOP_K=4
RRF_K_CONSTANT=60

# Agent Evaluation & Guardrail Thresholds
RELEVANCE_THRESHOLD=0.65          # Minimum doc grade score to proceed without query rewriting
MAX_AGENT_ITERATIONS=2            # Max query reformulations before fallback
ENABLE_HALLUCINATION_GUARD=true   # Enforce NLI consistency checking
